<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase" Name="MT_MinetechFactionBase" Abstract="True">
    <pawnSingular>miner</pawnSingular>
    <pawnsPlural>miners</pawnsPlural>
    <categoryTag>Outlander</categoryTag>
    <listOrderPriority>30</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>chief executive</leaderTitle>
    <factionIconPath>World/WorldObjects/Expanding/MTFaction</factionIconPath>
    <techLevel>Industrial</techLevel>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <allowedCultures>
      <li>Rustican</li>
      <li>Astropolitan</li>
    </allowedCultures>
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">4</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">2</Structure_Archist>
    </structureMemeWeights>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
    </requiredMemes>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_TheistEmbodied</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
    </disallowedMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">NutrientPasteEating_Disgusting</li>
    </disallowedPrecepts>
    <xenotypeSet>
      <xenotypeChances>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.05</Hussar>
        <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0.05</Dirtmole>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.025</Genie>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.025</Neanderthal>
        <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.025</Starjack>
      </xenotypeChances>
    </xenotypeSet>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.95</commonality>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.05</commonality>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_CombatSupplier</li>
      <li>Caravan_Outlander_Exotic</li>
      <li>Caravan_Outlander_PirateMerchant</li>
      <li>MT_Caravan_Outlander_MinerStash</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>MT_MinetechRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <MT_Miner>10</MT_Miner>
          <MT_Security>18</MT_Security>
          <Grenadier_Destructive>1.5</Grenadier_Destructive>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <MT_Miner>20</MT_Miner>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">10</Villager_Child>
          <MT_Security>10</MT_Security>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <MT_Miner>7</MT_Miner>
          <MT_Security>15</MT_Security>
          <Grenadier_Destructive>1.5</Grenadier_Destructive>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <MT_Miner>15</MT_Miner>
          <MT_Security>20</MT_Security>
          <Grenadier_Destructive>1.5</Grenadier_Destructive>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
        <commonality>1</commonality>
        <options>
          <MT_Miner>1</MT_Miner>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Hunters</kindDef>
        <commonality>0.8</commonality>
        <options>
          <Hunter>1</Hunter>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Loggers</kindDef>
        <commonality>0.7</commonality>
        <options>
          <Logger>1</Logger>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Farmers</kindDef>
        <commonality>0.5</commonality>
        <options>
          <Farmer>1</Farmer>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
  </FactionDef>

  <!-- MineTech Faction - Neutral/Civil Variant -->
  <FactionDef ParentName="MT_MinetechFactionBase">
    <defName>MT_MinetechCivil</defName>
    <label>MineTech consortium</label>
    <description>A corporate deep-crust excavation collective. Outfitted with heavy hazardous environment gear, industrial drilling equipment, and trained security personnel, they aggressively prospect the rimworld for rich mineral deposits. They maintain pragmatic, civil trade relations with settlements that respect their mining claims.</description>
    <colorSpectrum>
      <li>(0.88, 0.68, 0.22)</li>
      <li>(0.70, 0.50, 0.15)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>15</configurationListOrderPriority>
  </FactionDef>

  <!-- MineTech Faction - Hostile/Rough Syndicate Variant -->
  <FactionDef ParentName="MT_MinetechFactionBase">
    <defName>MT_MinetechRough</defName>
    <label>MineTech syndicate</label>
    <description>A rogue, heavily militarized branch of the MineTech corporation that operates with ruthless disregard for territorial sovereignty. They treat all outsiders as claim jumpers and hostile competitors, deploying demolition units and armed security to defend their mineral stashes and eliminate competition.</description>
    <colorSpectrum>
      <li>(0.75, 0.28, 0.14)</li>
      <li>(0.50, 0.18, 0.08)</li>
    </colorSpectrum>
    <naturalEnemy>true</naturalEnemy>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
    </requiredMemes>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>16</configurationListOrderPriority>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>MT_MinetechRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>MedicineIndustrial</li>
            <li>ComponentIndustrial</li>
            <li>MealSurvivalPack</li>
            <li>Neutroamine</li>
            <li>Steel</li>
            <li>Uranium</li>
            <li>Gold</li>
            <li>Jade</li>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

</Defs>